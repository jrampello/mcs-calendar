    { name: 'PacMUG \u2013 Seattle',                                        cat: 'mug',      start: '2026-06-24', end: '2026-06-24', loc: 'Des Moines, WA',        url: 'https://pacmug.org/' },
    { name: 'PacMUG \u2013 Portland',                                       cat: 'mug',      start: '2026-06-25', end: '2026-06-25', loc: 'Portland, OR',          url: 'https://pacmug.org/' },
    { name: 'PacMUG \u2013 Los Angeles',                                    cat: 'mug',      start: '2026-07-29', end: '2026-07-29', loc: 'Culver City, CA',       url: 'https://pacmug.org/' },
    { name: 'PacMUG \u2013 San Diego',                                      cat: 'mug',      start: '2026-07-30', end: '2026-07-30', loc: 'San Diego, CA',         url: 'https://pacmug.org/' },
    { name: 'MaximoWorld / TRIRIGAWorld 2026',                              cat: 'major',    start: '2026-08-17', end: '2026-08-20', loc: 'Nashville, TN',         url: 'https://web.cvent.com/event/482d1552-1365-4f3a-8bb9-3cc7e5b0ee81/summary', tririga: true },
    { name: 'SMRP Annual Conference 2026',                                  cat: 'industry', start: '2026-09-28', end: '2026-10-01', loc: 'Raleigh, NC',           url: 'https://smrp.org/Events/Annual-Conference' },
    { name: 'IAM North American Conference 2026',                           cat: 'industry', start: '2026-10-05', end: '2026-10-07', loc: 'Toronto, ON',           url: 'https://theiam.org/events/iam-north-american-conference-2026/' },
    { name: 'MainTrain 2026 (PEMAC)',                                       cat: 'industry', start: '2026-10-05', end: '2026-10-07', loc: 'Montr\u00e9al, QC',    url: 'https://www.pemac.org/events/conference' },
    { name: 'MUWG Fall 2026 \u2014 Maximo Unlocked',                       cat: 'muwg',     start: '2026-10-12', end: '2026-10-15', loc: 'Bloomington, MN',       url: 'https://www.muwg.org/' },
    { name: 'Fall Northeast MUG (NEMUG)',                                   cat: 'mug',      start: '2026-10-21', end: '2026-10-22', loc: 'Newport, RI',           url: 'https://nemugs.com/' },
    { name: 'IBM TechXchange 2026',                                         cat: 'major',    start: '2026-10-26', end: '2026-10-29', loc: 'Atlanta, GA',           url: 'https://www.ibm.com/events/techxchange' },
    { name: 'CanMUG Fall 2026',                                             cat: 'canada',   start: '2026-10-28', end: '2026-10-29', loc: 'Calgary, AB',           url: 'https://canmug.org/event-6578167' },
    { name: 'DCMUG',                                                        cat: 'mug',      start: '2026-11-05', end: '2026-11-05', loc: 'TBD',                   url: 'https://www.trmnet.com/' },
    { name: 'Florida MUG 2026 Annual Meeting',                              cat: 'mug',      start: '2026-11-05', end: '2026-11-05', loc: 'Orlando, FL',           url: 'https://starboard-consulting.com/maximo-industry-events/' },
    { name: 'IFMA World Workplace 2026',                                    cat: 'industry', start: '2026-11-18', end: '2026-11-20', loc: 'Anaheim, CA',           url: 'https://worldworkplace.ifma.org/', tririga: true },
    { name: 'International Maintenance Conference',                         cat: 'imc',      start: '2026-12-07', end: '2026-12-10', loc: 'Marco Island, FL',      url: 'https://maintenanceconference.com/' },

    // ── 2027 ──────────────────────────────────────────────────────────────
    { name: 'MSCM \u2013 MRO Supply Chain Matters Conference',              cat: 'industry', start: '2027-03-01', end: '2027-03-03', loc: 'Houston, TX',           url: 'https://www.mrosupplychainmatters.com/' },
    { name: 'MAXCON \u2013 Maximo, TRIRIGA & MREF Conference at Sea',       cat: 'maxcon',   start: '2027-04-05', end: '2027-04-09', loc: 'Port Canaveral, FL',    url: 'https://liquidenterprise.com/maxcon', tririga: true },
  ];

  var today = new Date(); today.setHours(0,0,0,0);

  // ── Recurring event patterns (months are 0-indexed: 0 = Jan, 11 = Dec) ──
  var RECURRING = [
    { name: 'Florida MUG (FLMUG)',           cat: 'mug',      months: [2, 10], loc: 'Florida',              url: 'https://moremaximo.com/events/calendar',                   lookahead: 18 },
    { name: 'Las Vegas MUG (LVMUG)',          cat: 'mug',      months: [2],     loc: 'Las Vegas, NV',        url: 'https://lvmug.org/',                                       lookahead: 18 },
    { name: 'CanMUG',                         cat: 'canada',   months: [5, 9],  loc: 'Canada',               url: 'https://canmug.org/',                                      lookahead: 18 },
    { name: 'Northeast MUG (NEMUG)',          cat: 'mug',      months: [4, 9],  loc: 'Northeast US',         url: 'https://nemugs.com/',                                      lookahead: 18 },
    { name: 'PacMUG',                         cat: 'mug',      months: [5, 6],  loc: 'West Coast',           url: 'https://pacmug.org/',                                      lookahead: 18 },
    { name: 'MUWG Spring Conference',         cat: 'muwg',     months: [3],     loc: 'TBD',                  url: 'https://www.muwg.org/',                                    lookahead: 18 },
    { name: 'MUWG Fall Conference',           cat: 'muwg',     months: [9],     loc: 'TBD',                  url: 'https://www.muwg.org/',                                    lookahead: 18 },
    { name: 'IBM TechXchange',                cat: 'major',    months: [9],     loc: 'TBD',                  url: 'https://www.ibm.com/events/techxchange',                   lookahead: 24 },
    { name: 'MaximoWorld / TRIRIGAWorld',     cat: 'major',    months: [7],     loc: 'TBD',                  url: 'https://reliabilityweb.com/en/events/',                    lookahead: 24, tririga: true },
    { name: 'International Maintenance Conference (IMC)', cat: 'imc', months: [11], loc: 'Marco Island, FL', url: 'https://maintenanceconference.com/',                       lookahead: 18 },
    { name: 'GOMaximo',                       cat: 'mug',      months: [3],     loc: 'Houston, TX',          url: 'https://www.gomaximo.org/',                                lookahead: 18 },
    { name: 'Airport MUG (AMUG)',             cat: 'mug',      months: [5],     loc: 'TBD',                  url: 'https://airportmug.com/',                                  lookahead: 18 },
    { name: 'Carolinas MUG',                  cat: 'mug',      months: [4],     loc: 'Carolinas',            url: 'https://moremaximo.com/events/calendar',                   lookahead: 18 },
    { name: 'Southwest MUG (SWMUG)',          cat: 'mug',      months: [4],     loc: 'Southwest US',         url: 'https://swmug.org/',                                       lookahead: 18 },
    { name: 'West Mountain MUG (WMMUG)',      cat: 'mug',      months: [4],     loc: 'Mountain West',        url: 'https://wmmug.org/',                                       lookahead: 18 },
    { name: 'MAXCON Cruise Conference',       cat: 'maxcon',   months: [3],     loc: 'TBD',                  url: 'https://liquidenterprise.com/maxcon', lookahead: 24, tririga: true },
    { name: 'MSCM \u2013 MRO Supply Chain Matters Conference', cat: 'industry', months: [2], loc: 'Houston, TX',  url: 'https://www.mrosupplychainmatters.com/',              lookahead: 24 },
    { name: 'SMRP Annual Conference',         cat: 'industry', months: [8],     loc: 'TBD',                  url: 'https://smrp.org/Events/Annual-Conference',                lookahead: 24 },
    { name: 'IAM North American Conference',  cat: 'industry', months: [9],     loc: 'Canada',               url: 'https://theiam.org/events/',                               lookahead: 24 },
    { name: 'MainTrain (PEMAC)',              cat: 'industry', months: [9],     loc: 'Canada',               url: 'https://www.pemac.org/events/conference',                  lookahead: 24 },
    { name: 'The Reliability Conference',     cat: 'industry', months: [4],     loc: 'TBD',                  url: 'https://reliabilityweb.com/en/events/',                    lookahead: 24 },
    { name: 'IFMA World Workplace',           cat: 'industry', months: [10],    loc: 'TBD',                  url: 'https://worldworkplace.ifma.org/',                         lookahead: 24, tririga: true },
  ];

  // ── Projection engine ─────────────────────────────────────────────────────
  function buildProjected() {
    var projected = [];

    RECURRING.forEach(function(r) {
      var maxMonths = r.lookahead || 18;
      var maxHorizon = new Date(today);
      maxHorizon.setMonth(maxHorizon.getMonth() + maxMonths);

      var covered = {};
      EVENTS.forEach(function(e) {
        var rWords = r.name.toLowerCase().split(/[\s\/\-\(\)]+/).filter(function(w){ return w.length > 3; });
        var eName  = e.name.toLowerCase();
        var matches = rWords.filter(function(w){ return eName.indexOf(w) >= 0; });
        var firstWord = rWords[0] || '';
        var firstMatches = firstWord.length >= 4 && eName.indexOf(firstWord) >= 0;
        if (matches.length >= 2 || (rWords.length === 1 && matches.length === 1) || firstMatches) {
          var ym = e.start.slice(0, 7);
          covered[ym] = true;
        }
      });

      var yr = today.getFullYear();
      var endYr = maxHorizon.getFullYear();

      for (var y = yr; y <= endYr; y++) {
        r.months.forEach(function(m) {
          var projDate = new Date(y, m, 1);
          if (projDate < today) return;
          if (projDate > maxHorizon) return;
          var ym = y + '-' + (m < 9 ? '0' : '') + (m + 1);
          if (covered[ym]) return;

          projected.push({
            name:      r.name,
            cat:       r.cat,
            start:     ym + '-01',
            end:       ym + '-01',
            loc:       r.loc,
            url:       r.url,
            tririga:   r.tririga || false,
            predicted: true,
          });
        });
      }
    });

    return projected;
  }

  function getAllEvents() {
    var proj = buildProjected();
    var all  = EVENTS.concat(proj);
    all.sort(function(a, b) {
      var d = a.start.localeCompare(b.start);
      if (d !== 0) return d;
      return (a.predicted ? 1 : 0) - (b.predicted ? 1 : 0);
    });
    return all;
  }

  function parseD(s){var p=s.split('-');return new Date(+p[0],+p[1]-1,+p[2]);}

  function fmtRange(e) {
    if (e.predicted) {
      var d = parseD(e.start);
      return d.toLocaleDateString('en-US', {month:'long'}) + ' ' + d.getFullYear() + ' \u2014 date TBD';
    }
    var a=parseD(e.start),b=parseD(e.end),mo=a.toLocaleDateString('en-US',{month:'short'});
    if(e.start===e.end) return mo+' '+a.getDate()+', '+a.getFullYear();
    if(a.getMonth()===b.getMonth()&&a.getFullYear()===b.getFullYear()) return mo+' '+a.getDate()+'\u2013'+b.getDate()+', '+b.getFullYear();
    return mo+' '+a.getDate()+' \u2013 '+b.toLocaleDateString('en-US',{month:'short'})+' '+b.getDate()+', '+b.getFullYear();
  }

  function isPast(e)     { return !e.predicted && parseD(e.end) < today; }
  function isUpcoming(e) { return e.predicted || parseD(e.end) >= today; }

  var view='month', filter='confirmed';
  var ALL_EVENTS = getAllEvents();

  function getFiltered(){
    var cutoff=new Date(today); cutoff.setMonth(cutoff.getMonth()-12);
    return ALL_EVENTS.filter(function(e){
      if(filter==='past')      return isPast(e) && !e.predicted;
      if(!e.predicted && parseD(e.end)<cutoff) return false;
      if(filter==='tririga')   return !!e.tririga && !e.predicted && isUpcoming(e);
      if(filter==='confirmed') return !e.predicted && isUpcoming(e);
      if(filter==='upcoming')  return isUpcoming(e);
      if(filter==='all')       return true;
      return e.cat===filter && !e.predicted && isUpcoming(e);
    });
  }

  function renderSpot(){
    var up=EVENTS.filter(isUpcoming).sort(function(a,b){return parseD(a.start)-parseD(b.start);});
    if(!up.length) return;
    var e=up[0], c=CATS[e.cat];
    var days=Math.ceil((parseD(e.start)-today)/86400000);
    var label=days===0?'Today':days===1?'Tomorrow':'In '+days+' days';
    document.getElementById('mcal-spot-name').textContent=e.name;
    document.getElementById('mcal-spot-date').textContent=fmtRange(e);
    document.getElementById('mcal-spot-loc').textContent='\ud83d\udccd '+e.loc;
    document.getElementById('mcal-spot-badge').innerHTML='<span class="mcal-spot-badge" style="background:'+c.bg+'">'+label+'</span>';
  }

  function renderMonth(){
    var evts=getFiltered();
    if(!evts.length){document.getElementById('mcal-view-month').innerHTML='<div class="mcal-empty">No events match this filter.</div>';return;}
    var byYM={};
    evts.forEach(function(e){var k=e.start.slice(0,7);if(!byYM[k])byYM[k]=[];byYM[k].push(e);});
    var keys=Object.keys(byYM).sort();
    var years=[];
    keys.forEach(function(k){var y=k.slice(0,4);if(years.indexOf(y)<0)years.push(y);});
    var html='<div class="mcal-months">';
    years.forEach(function(yr){
      html+='<div class="mcal-yr-lbl">'+yr+'</div>';
      keys.filter(function(k){return k.startsWith(yr);}).forEach(function(mk){
        var mo=new Date(mk+'-02').toLocaleDateString('en-US',{month:'short'});
        html+='<div class="mcal-month-row"><div class="mcal-month-lbl">'+mo+'</div><div class="mcal-month-evts">';
        byYM[mk].forEach(function(e){
          var c=CATS[e.cat];
          var past=isPast(e)?' past':'';
          var pred=e.predicted?' predicted':'';
          var pillStyle=e.predicted
            ? 'border:2px dashed '+c.bg+';color:'+c.bg+';text-decoration:none'
            : 'background:'+c.bg+';text-decoration:none';
          var tbdTag=e.predicted?'<span class="mcal-pill-tbd">TBD</span>':'';
          var inner='<span style="width:7px;height:7px;border-radius:50%;background:'+(e.predicted?c.bg:'rgba(255,255,255,0.4)')+';display:inline-block;flex-shrink:0"></span>'+e.name+tbdTag+'<span class="mcal-pill-city"> \u00b7 '+fmtRange(e)+'</span>';
          var tooltip=e.name+' \u00b7 '+fmtRange(e)+' \u00b7 '+e.loc+(e.predicted?' (predicted based on history)':'');
          if(e.url){html+='<a href="'+e.url+'" target="_blank" class="mcal-pill'+past+pred+'" style="'+pillStyle+'" title="'+tooltip+'">'+inner+'</a>';}
          else{html+='<div class="mcal-pill'+past+pred+'" style="background:'+c.bg+'" title="'+tooltip+'">'+inner+'</div>';}
        });
        html+='</div></div>';
      });
    });
    html+='</div>';
    document.getElementById('mcal-view-month').innerHTML=html;
  }

  function renderList(){
    var evts=getFiltered();
    if(!evts.length){document.getElementById('mcal-view-list').innerHTML='<div class="mcal-empty">No events match this filter.</div>';return;}
    var html='<div class="mcal-list">', curYr='';
    evts.forEach(function(e){
      var yr=e.start.slice(0,4);
      if(yr!==curYr){html+='<div class="mcal-yr-lbl">'+yr+'</div>';curYr=yr;}
      var c=CATS[e.cat];
      var past=isPast(e)?' past':'';
      var pred=e.predicted?' predicted':'';
      var predBadge=e.predicted?'<span class="mcal-predicted-badge">Date TBD</span>':'';
      html+='<div class="mcal-list-item'+past+pred+'">';
      html+='<div class="mcal-list-dot" style="background:'+c.bg+(e.predicted?';opacity:0.6':'')+';border:'+(e.predicted?'2px dashed '+c.bg:'none')+'"></div>';
      html+='<div><div class="mcal-list-name">';
      html+=(e.url?'<a href="'+e.url+'" target="_blank">'+e.name+'</a>':e.name);
      html+='<span class="mcal-list-tag" style="background:'+c.bg+'">'+c.label+'</span>';
      html+=predBadge;
      html+='</div><div class="mcal-list-meta">'+fmtRange(e)+' &nbsp;\u00b7&nbsp; '+e.loc+'</div></div></div>';
    });
    html+='</div>';
    document.getElementById('mcal-view-list').innerHTML=html;
  }

  window.mcalSV=function(v){
    view=v;
    document.getElementById('mcal-btn-month').classList.toggle('on',v==='month');
    document.getElementById('mcal-btn-list').classList.toggle('on',v==='list');
    document.getElementById('mcal-view-month').style.display=v==='month'?'':'none';
    document.getElementById('mcal-view-list').style.display=v==='list'?'':'none';
    if(v==='month') renderMonth(); else renderList();
  };

  var FILTER_IDS = ['all','major','mug','canada','imc','muwg','maxcon','tririga','industry','intl','upcoming','past','confirmed'];
  var FILTER_CAT = {
    major: 'major', mug: 'mug', canada: 'canada',
    imc: 'imc', muwg: 'muwg', maxcon: 'maxcon', tririga: 'tririga', industry: 'industry'
  };

  window.mcalSF=function(f){
    filter=f;
    FILTER_IDS.forEach(function(id){
      var btn = document.getElementById('mcal-f-'+id);
      if (!btn) return;
      var isOn = (id === f);
      btn.classList.toggle('on', isOn);
      if (isOn && FILTER_CAT[id]) {
        btn.style.background = CATS[FILTER_CAT[id]].bg;
        btn.style.borderColor = CATS[FILTER_CAT[id]].bg;
        btn.style.color = '#fff';
      } else if (!isOn && FILTER_CAT[id]) {
        btn.style.background = '';
        btn.style.borderColor = CATS[FILTER_CAT[id]].bg;
        btn.style.color = CATS[FILTER_CAT[id]].bg;
      } else if (isOn) {
        btn.style.background = '#5A2F90';
        btn.style.borderColor = '#5A2F90';
        btn.style.color = '#fff';
      } else {
        btn.style.background = '';
        btn.style.borderColor = '';
        btn.style.color = '';
      }
    });
    if(view==='month') renderMonth(); else renderList();
  };

  renderSpot(); renderMonth();

  // Apply category border colors to filter buttons on load
  Object.keys(FILTER_CAT).forEach(function(id){
    var btn = document.getElementById('mcal-f-'+id);
    if (btn && CATS[id]) {
      btn.style.borderColor = CATS[id].bg;
      btn.style.color = CATS[id].bg;
    }
  });

})();

// Overflow fix
(function(){
  document.documentElement.style.overflowX='hidden';
  document.body.style.overflowX='hidden';
  document.body.style.maxWidth='100%';
  var page=document.querySelector('.cal-page');
  if(!page) return;
  page.style.width='100%'; page.style.maxWidth='100%'; page.style.overflowX='hidden';
  var el=page.parentElement;
  for(var i=0;i<8;i++){
    if(!el||el===document.body) break;
    var cs=window.getComputedStyle(el);
    if(parseFloat(cs.marginLeft)<0) el.style.marginLeft='0px';
    if(parseFloat(cs.left)<0) el.style.left='0px';
    el.style.overflowX='hidden'; el.style.maxWidth='100%';
    el=el.parentElement;
  }
})();
</script>
