<!-- ============================================================
     MAX CONTENT SOLUTIONS — CONFERENCE CALENDAR PAGE EMBED
     Brand: Inter | #1F1A2E | #5A2F90 | #886CAE | #CDBDD9
            #C8873A | #F0D9BC | #2E6E8E | #F5F3F7

     HOW TO USE IN WEBFLOW:
     1. Delete every section between your header and footer
     2. Add a single "Embed" block in that empty space
     3. Double-click → paste ALL of this code → Save & Close
     4. Set the Webflow SECTION wrapping this embed:
        - Background: #1F1A2E
        - Padding: 0 on all sides

     CHANGED IN THIS VERSION (Sept 27, 2026):
     - Added Florida MUG 2026 Annual Meeting (Nov 5, Orlando)
     - Florida MUG projection now March + November
     - SMRP projection moved to September (prevents duplicate)
     - CanMUG Fall 2026 location standardized to "Calgary, AB"
     - DCMUG link corrected to trmnet.com
     - MSCM recategorized as EAM Industry
     - "Upcoming only" button now highlights correctly
     - Footer CTA: "your firm" changed to "your company"
     ============================================================ -->

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

html, body { overflow-x: hidden !important; max-width: 100% !important; }

.cal-page *, .cal-page *::before, .cal-page *::after {
  box-sizing: border-box; margin: 0; padding: 0; text-align: left;
}
.cal-page {
  font-family: 'Inter', -apple-system, 'Helvetica Neue', Arial, sans-serif;
  font-size: 20px; line-height: 1.6; color: #1F1A2E;
  width: 100%; max-width: 100%; overflow-x: hidden;
}

/* ── Shared tokens ── */
.cal-eyebrow {
  display: inline-flex; align-items: center; gap: 10px;
  font-size: 20px; font-weight: 700; letter-spacing: 0.13em;
  text-transform: uppercase; color: #C8873A; margin-bottom: 16px;
}
.cal-eyebrow::before {
  content: ''; display: block; width: 20px; height: 1.5px;
  background: #C8873A; flex-shrink: 0;
}
.cal-gold-rule { width: 36px; height: 2px; background: #C8873A; margin: 16px 0 22px; }
.cal-divider { height: 1px; background: linear-gradient(to right, transparent, #CDBDD9, transparent); }

/* ── Buttons ── */
.cal-btn-gold {
  display: inline-block; background: #C8873A; color: #fff;
  text-decoration: none; font-size: 20px; font-weight: 700;
  padding: 14px 28px; border-radius: 6px; border: none; cursor: pointer;
  transition: background 0.2s, transform 0.15s; line-height: 1;
}
.cal-btn-gold:hover { background: #d9944a; color: #fff; transform: translateY(-1px); }
.cal-btn-outline {
  display: inline-block; background: transparent; color: #CDBDD9;
  text-decoration: none; font-size: 20px; font-weight: 500;
  padding: 13px 28px; border-radius: 6px; border: 1px solid #5A2F90;
  cursor: pointer; transition: border-color 0.2s, color 0.2s; line-height: 1;
}
.cal-btn-outline:hover { border-color: #886CAE; color: #fff; }
.cal-btn-subscribe {
  display: inline-flex; align-items: center; gap: 8px;
  background: transparent; color: rgba(255,255,255,0.6);
  text-decoration: none; font-size: 20px; font-weight: 500;
  padding: 13px 22px; border-radius: 6px;
  border: 1px solid rgba(255,255,255,0.18);
  cursor: pointer; transition: border-color 0.2s, color 0.2s; line-height: 1;
}
.cal-btn-subscribe:hover { border-color: rgba(255,255,255,0.45); color: #fff; }
.cal-btn-subscribe svg { flex-shrink: 0; opacity: 0.7; transition: opacity 0.2s; }
.cal-btn-subscribe:hover svg { opacity: 1; }
.cal-cta-row { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }

/* ════════════════════════════════════
   S1 — HERO
════════════════════════════════════ */
.cal-hero {
  background: #1F1A2E; width: 100%;
  padding: 64px 32px 56px; position: relative; overflow: hidden;
}
.cal-hero::before {
  content: ''; position: absolute; top: -100px; right: -100px;
  width: 440px; height: 440px; border-radius: 50%;
  background: radial-gradient(circle, rgba(90,47,144,0.3) 0%, transparent 65%);
  pointer-events: none;
}
.cal-hero::after {
  content: ''; position: absolute; bottom: -60px; left: 10%;
  width: 280px; height: 280px; border-radius: 50%;
  background: radial-gradient(circle, rgba(200,135,58,0.08) 0%, transparent 65%);
  pointer-events: none;
}
.cal-hero__inner {
  position: relative; z-index: 1;
  display: grid; grid-template-columns: 1.2fr 0.8fr;
  gap: 48px; align-items: center;
}
.cal-hero__content { max-width: 560px; }
.cal-hero__graphic { display: flex; align-items: center; justify-content: center; }
.cal-hero__graphic svg { width: 100%; max-width: 280px; height: auto; }
.cal-hero__h1 {
  font-size: clamp(26px, 3.5vw, 40px); font-weight: 700;
  color: #fff; line-height: 1.15; margin-bottom: 8px;
}
.cal-hero__h1 .cal-lilac { color: #CDBDD9; }
.cal-hero__sub {
  font-size: 20px; color: rgba(255,255,255,0.62);
  line-height: 1.78; margin-bottom: 28px; max-width: 540px;
}
.cal-hero__sub strong { color: rgba(255,255,255,0.9); font-weight: 600; }
.cal-hero__trust {
  display: flex; flex-wrap: wrap; gap: 18px;
  padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.07); margin-top: 28px;
}
.cal-trust-item {
  display: inline-flex; align-items: center; gap: 7px;
  font-size: 20px; color: rgba(255,255,255,0.45);
}
.cal-trust-item::before { content: '✓'; color: #C8873A; font-weight: 700; }

/* ════════════════════════════════════
   S2 — CALENDAR BODY
════════════════════════════════════ */
.cal-body {
  background: #F5F3F7; width: 100%; padding: 56px 32px 64px;
}

/* ── Spotlight card (next event) ── */
.mcal-spot {
  background: #1F1A2E;
  border: 1px solid rgba(90,47,144,0.4);
  border-radius: 12px; padding: 24px 28px; margin-bottom: 28px;
  position: relative; overflow: hidden;
}
.mcal-spot::before {
  content: ''; position: absolute; top: -40px; right: -40px;
  width: 180px; height: 180px; border-radius: 50%;
  background: radial-gradient(circle, rgba(90,47,144,0.25) 0%, transparent 68%);
  pointer-events: none;
}
.mcal-spot-lbl {
  font-size: 20px; font-weight: 700; letter-spacing: 0.1em;
  text-transform: uppercase; color: #C8873A; margin-bottom: 8px;
}
.mcal-spot-name { font-size: 22px; font-weight: 700; color: #fff; margin-bottom: 6px; }
.mcal-spot-meta {
  font-size: 20px; color: rgba(255,255,255,0.55);
  display: flex; gap: 20px; flex-wrap: wrap; margin-bottom: 10px;
}
.mcal-spot-badge {
  display: inline-block; padding: 5px 16px; border-radius: 100px;
  font-size: 20px; font-weight: 700; color: #fff;
}

/* ── Controls ── */
.mcal-ctls {
  display: flex; gap: 8px; flex-wrap: wrap;
  align-items: center; margin-bottom: 24px;
}
.mcal-btn {
  font-family: 'Inter', sans-serif;
  font-size: 20px; font-weight: 500; padding: 8px 16px;
  border-radius: 6px; border: 1px solid #CDBDD9;
  background: #fff; color: #886CAE;
  cursor: pointer; transition: all 0.15s; line-height: 1.3;
}
.mcal-btn:hover { background: #F5F3F7; color: #5A2F90; border-color: #886CAE; }
.mcal-btn.on {
  background: #5A2F90; color: #fff;
  border-color: #5A2F90; font-weight: 700;
}
.mcal-sep {
  width: 1px; height: 28px;
  background: #CDBDD9; flex-shrink: 0;
}

/* ── Legend ── */
.mcal-legend {
  display: flex; flex-wrap: wrap; gap: 8px;
  margin-bottom: 24px;
}
.mcal-leg {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 20px; color: #fff; font-weight: 600;
  padding: 7px 16px; border-radius: 100px;
}
.mcal-leg-dot { display: none; }
.mcal-leg.predicted-leg {
  background: transparent !important;
  border: 2px dashed #C8873A;
  color: #C8873A;
}

/* ── Year label ── */
.mcal-yr-lbl {
  font-size: 20px; font-weight: 700; color: #5A2F90;
  text-transform: uppercase; letter-spacing: 0.08em;
  padding: 16px 0 6px;
  border-top: 2px solid #CDBDD9; margin-top: 8px;
}
.mcal-yr-lbl:first-child { margin-top: 0; border-top: none; padding-top: 0; }

/* ── Month view ── */
.mcal-months { display: flex; flex-direction: column; }
.mcal-month-row {
  display: grid;
  grid-template-columns: 64px 1fr;
  gap: 12px;
  align-items: flex-start;
  border-top: 1px solid #CDBDD9; padding: 10px 0;
}
.mcal-month-lbl {
  font-size: 20px; font-weight: 700;
  color: #886CAE; text-transform: uppercase;
  letter-spacing: 0.05em; padding-top: 6px;
  flex-shrink: 0; min-width: 0;
}
.mcal-month-evts {
  display: flex; flex-wrap: wrap; gap: 8px;
  min-width: 0;
}

/* ── Pills ── */
.mcal-pill {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 6px 14px; border-radius: 100px;
  font-size: 20px; font-weight: 600; color: #fff;
  cursor: default; white-space: nowrap;
  transition: opacity 0.15s, transform 0.15s;
  text-decoration: none;
}
.mcal-pill:hover { transform: translateY(-1px); opacity: 0.9; }
.mcal-pill.past { opacity: 0.3; }
.mcal-pill-city { font-size: 20px; font-weight: 400; opacity: 0.8; }

/* ── List view ── */
.mcal-list { display: flex; flex-direction: column; }
.mcal-list-item {
  display: flex; align-items: flex-start; gap: 16px;
  padding: 14px 0; border-top: 1px solid #CDBDD9;
}
.mcal-list-item.past { opacity: 0.35; }
.mcal-list-dot {
  width: 12px; height: 12px; border-radius: 50%;
  flex-shrink: 0; margin-top: 6px;
}
.mcal-list-name {
  font-size: 20px; font-weight: 600; color: #1F1A2E;
}
.mcal-list-name a { color: #2E6E8E; text-decoration: none; }
.mcal-list-name a:hover { color: #5A2F90; text-decoration: underline; }
.mcal-list-meta { font-size: 20px; color: #886CAE; margin-top: 4px; }
.mcal-list-tag {
  display: inline-block; font-size: 20px; font-weight: 700;
  padding: 2px 10px; border-radius: 100px;
  margin-left: 10px; vertical-align: middle; color: #fff;
}

/* ── Empty state ── */
.mcal-empty { padding: 2rem 0; color: #886CAE; font-size: 20px; }

/* ── Predicted / TBD events ── */
.mcal-pill.predicted {
  opacity: 0.65;
  border: 2px dashed rgba(255,255,255,0.5) !important;
  background: transparent !important;
  position: relative;
}
.mcal-pill.predicted .mcal-pill-tbd {
  font-size: 20px; font-weight: 700;
  background: rgba(255,255,255,0.2);
  border-radius: 4px; padding: 0 5px;
  margin-left: 2px;
}
.mcal-list-item.predicted { opacity: 0.65; }
.mcal-list-item.predicted .mcal-list-name { font-style: italic; }
.mcal-predicted-badge {
  display: inline-block; font-size: 20px; font-weight: 700;
  letter-spacing: 0.06em; text-transform: uppercase;
  background: rgba(200,135,58,0.15); color: #C8873A;
  border: 1px solid rgba(200,135,58,0.35);
  border-radius: 4px; padding: 1px 8px;
  margin-left: 8px; vertical-align: middle;
}

/* ── Footer / sources ── */
.cal-sources-section {
  background: #1F1A2E; width: 100%; padding: 40px 32px 44px;
}
.cal-sources-note {
  font-size: 20px; color: rgba(255,255,255,0.6);
  line-height: 1.65; margin-bottom: 20px;
}
.cal-sources-note a {
  color: #C8873A; text-decoration: none; font-weight: 600;
}
.cal-sources-note a:hover { text-decoration: underline; }
.cal-sources-label {
  font-size: 20px; font-weight: 700; letter-spacing: 0.1em;
  text-transform: uppercase; color: #886CAE; margin-bottom: 12px;
}
.cal-sources-links {
  display: flex; flex-wrap: wrap; gap: 10px;
}
.cal-sources-links a {
  display: inline-block; font-size: 20px; font-weight: 500;
  color: rgba(255,255,255,0.55); text-decoration: none;
  background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
  padding: 6px 14px; border-radius: 6px;
  transition: color 0.15s, background 0.15s;
}
.cal-sources-links a:hover {
  color: #fff; background: rgba(90,47,144,0.3);
  border-color: rgba(90,47,144,0.5);
}

/* ════════════════════════════════════
   S3 — FOOTER CTA
════════════════════════════════════ */
.cal-cta {
  background: #F5F3F7; width: 100%;
  padding: 64px 32px 56px; text-align: center;
}
.cal-cta__inner { max-width: 560px; margin: 0 auto; }
.cal-cta h2 {
  font-size: clamp(22px, 3vw, 30px); font-weight: 700;
  color: #5A2F90; line-height: 1.2; margin-bottom: 14px;
}
.cal-cta p {
  font-size: 20px; color: #886CAE;
  line-height: 1.75; margin-bottom: 28px;
}
.cal-cta .cal-cta-row { justify-content: center; }
.cal-cta__tagline {
  display: block; margin-top: 28px; font-size: 20px; font-weight: 700;
  letter-spacing: 0.1em; text-transform: uppercase; color: #CDBDD9;
}

/* ════════════════════════════════════
   RESPONSIVE
════════════════════════════════════ */
@media (max-width: 900px) {
  .mcal-ctls { gap: 6px; }
  .mcal-month-lbl { width: 40px; font-size: 20px; }
  .cal-hero__inner { grid-template-columns: 1fr; gap: 32px; }
  .cal-hero__graphic svg { max-width: 220px; }
}
@media (max-width: 600px) {
  .cal-hero, .cal-body, .cal-sources-section, .cal-cta {
    padding: 48px 20px 44px !important;
  }
  .cal-hero__h1 { font-size: 26px !important; word-break: break-word; }
  .cal-cta__inner { max-width: 100%; }
  .cal-cta-row { flex-direction: column !important; }
  .cal-cta-row a { width: 100% !important; text-align: center !important; }
  .mcal-ctls { gap: 6px; }
  .mcal-pill { font-size: 20px; padding: 5px 10px; }
}
</style>

<div class="cal-page">

<!-- ════════════════════════════════════
     S1 — HERO
════════════════════════════════════ -->
<section class="cal-hero">
  <div class="cal-hero__inner">
    <div class="cal-hero__content">
      <div class="cal-eyebrow">Maximo community</div>
      <h1 class="cal-hero__h1">IBM Maximo<br><span class="cal-lilac">Conference Calendar</span></h1>
      <div class="cal-gold-rule"></div>
      <p class="cal-hero__sub">Every major Maximo conference, user group meeting, and industry event in one place. <strong>Updated regularly</strong> so you never miss a chance to connect with the ecosystem.</p>
      <div class="cal-cta-row">
        <a href="mailto:info@maxcontentsolutions.com?subject=Calendar Correction or Submission" class="cal-btn-gold">Submit or correct an event</a>
        <a href="https://liquidenterprise.com/maxcon" class="cal-btn-outline">MAXCON™ 2027 Event</a>
        <a href="https://raw.githubusercontent.com/jrampello/mcs-calendar/refs/heads/main/maximo-conference-calendar.ics" class="cal-btn-subscribe" title="Subscribe — new events sync automatically to your calendar app">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="1" y="3" width="14" height="12" rx="2" stroke="currentColor" stroke-width="1.4"/>
            <path d="M1 7h14" stroke="currentColor" stroke-width="1.4"/>
            <path d="M5 1v3M11 1v3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            <path d="M8 10v2M7 11h2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
          Subscribe to calendar
        </a>
      </div>
      <div class="cal-hero__trust">
        <span class="cal-trust-item">Maximo &amp; EAM events worldwide</span>
        <span class="cal-trust-item">User groups, conferences &amp; training</span>
        <span class="cal-trust-item">Verify dates before travel</span>
        <span class="cal-trust-item">Auto-syncs to your calendar app</span>
      </div>
    </div>
    <div class="cal-hero__graphic">
      <svg viewBox="0 0 320 320" xmlns="http://www.w3.org/2000/svg">
        <rect x="55" y="60" width="210" height="200" rx="20" fill="#5A2F90"/>
        <rect x="100" y="42" width="14" height="34" rx="7" fill="#C8873A"/>
        <rect x="206" y="42" width="14" height="34" rx="7" fill="#C8873A"/>
        <rect x="55" y="100" width="210" height="160" rx="16" fill="#F5F3F7"/>
        <circle cx="90" cy="145" r="6" fill="#CDBDD9"/>
        <circle cx="140" cy="145" r="8" fill="#C8873A"/>
        <circle cx="190" cy="145" r="6" fill="#CDBDD9"/>
        <circle cx="90" cy="185" r="6" fill="#CDBDD9"/>
        <circle cx="140" cy="185" r="6" fill="#CDBDD9"/>
        <circle cx="219" cy="185" r="8" fill="#C8873A"/>
        <circle cx="90" cy="225" r="8" fill="#C8873A"/>
        <circle cx="140" cy="225" r="6" fill="#CDBDD9"/>
        <circle cx="190" cy="225" r="6" fill="#CDBDD9"/>
        <path d="M219 185 L245 222" stroke="#C8873A" stroke-width="2" stroke-dasharray="4 4" opacity="0.5"/>
        <g transform="translate(250,250)">
          <path d="M0 -26c-14 0-26 12-26 26c0 20 26 46 26 46s26-26 26-46c0-14-12-26-26-26z" fill="#C8873A"/>
          <circle cx="0" cy="0" r="10" fill="#F5F3F7"/>
        </g>
      </svg>
    </div>
  </div>
</section>

<div class="cal-divider"></div>

<!-- ════════════════════════════════════
     S2 — CALENDAR
════════════════════════════════════ -->
<section class="cal-body">

  <!-- Spotlight: next event -->
  <div class="mcal-spot">
    <div class="mcal-spot-lbl">Next upcoming event</div>
    <div class="mcal-spot-name" id="mcal-spot-name">—</div>
    <div class="mcal-spot-meta">
      <span id="mcal-spot-date">—</span>
      <span id="mcal-spot-loc">—</span>
    </div>
    <div id="mcal-spot-badge"></div>
  </div>

  <!-- Controls -->
  <div class="mcal-ctls">
    <button class="mcal-btn on" id="mcal-btn-month" onclick="mcalSV('month')">📅 Monthly</button>
    <button class="mcal-btn"   id="mcal-btn-list"   onclick="mcalSV('list')">☰ List</button>
    <div class="mcal-sep"></div>
    <button class="mcal-btn"    id="mcal-f-all"       onclick="mcalSF('all')">All</button>
    <button class="mcal-btn"    id="mcal-f-major"     onclick="mcalSF('major')">MaximoWorld / TechXchange</button>
    <button class="mcal-btn"    id="mcal-f-mug"       onclick="mcalSF('mug')">MUGs</button>
    <button class="mcal-btn"    id="mcal-f-canada"    onclick="mcalSF('canada')">CanMUG</button>
    <button class="mcal-btn"    id="mcal-f-imc"       onclick="mcalSF('imc')">IMC</button>
    <button class="mcal-btn"    id="mcal-f-muwg"      onclick="mcalSF('muwg')">MUWG</button>
    <button class="mcal-btn"    id="mcal-f-maxcon"    onclick="mcalSF('maxcon')">MAXCON Event</button>
    <button class="mcal-btn"    id="mcal-f-tririga"   onclick="mcalSF('tririga')">Tririga/MREF</button>
    <button class="mcal-btn"    id="mcal-f-industry"  onclick="mcalSF('industry')">EAM Industry</button>
    <button class="mcal-btn"    id="mcal-f-intl"      onclick="mcalSF('intl')">International</button>
    <button class="mcal-btn on" id="mcal-f-confirmed" onclick="mcalSF('confirmed')">Upcoming only</button>
    <button class="mcal-btn"    id="mcal-f-past"      onclick="mcalSF('past')">Past</button>
  </div>

  <!-- Views -->
  <div id="mcal-view-month"></div>
  <div id="mcal-view-list" style="display:none"></div>

</section>

<div class="cal-divider"></div>

<!-- ════════════════════════════════════
     SOURCES
════════════════════════════════════ -->
<section class="cal-sources-section">
  <p class="cal-sources-note">Verify dates before travel. Missing an event or need a correction? Email <a href="mailto:info@maxcontentsolutions.com">info@maxcontentsolutions.com</a></p>
  <div class="cal-sources-label">Event sources</div>
  <div class="cal-sources-links">
    <a href="https://moremaximo.com/events/calendar" target="_blank">MORE Community</a>
    <a href="https://starboard-consulting.com/maximo-industry-events/" target="_blank">Starboard Consulting</a>
    <a href="https://reliabilityweb.com/en/events/" target="_blank">ReliabilityWeb</a>
    <a href="https://www.muwg.org/" target="_blank">MUWG</a>
    <a href="https://www.gomaximo.org/" target="_blank">GOMaximo</a>
    <a href="https://canmug.org/events" target="_blank">CanMUG</a>
    <a href="https://nemugs.com/" target="_blank">NEMUG</a>
    <a href="https://pacmug.org/" target="_blank">PacMUG</a>
    <a href="https://wmmug.org/" target="_blank">WMMUG</a>
    <a href="https://swmug.org/" target="_blank">SWMUG</a>
    <a href="https://airportmug.com/" target="_blank">AMUG</a>
    <a href="https://maintenanceconference.com/" target="_blank">IMC</a>
    <a href="https://lvmug.org/" target="_blank">LVMUG</a>
    <a href="https://fmmug.org/" target="_blank">FMMUG</a>
    <a href="https://maximogroups.org/" target="_blank">MaximoGroups.org</a>
    <a href="https://liquidenterprise.com/maxcon" target="_blank">MAXCON</a>
    <a href="https://www.ibm.com/events/techxchange" target="_blank">IBM TechXchange</a>
    <a href="https://community.ibm.com/community/user/events/usergroupsevents" target="_blank">IBM Community</a>
